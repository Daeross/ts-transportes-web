<section id="galeria">
  <div class="galeria-header">
    <h2 class="stitle">NUESTRAS <span class="blue-word">OPERACIONES</span></h2>
    <p class="galeria-sub">Haz clic en cualquier imagen para ver todas las fotos de esa operación.</p>
  </div>

  <div class="mosaic">
    <div class="mitem tall" onclick="openOpPanel('maquinaria',2)" role="button" tabindex="0" aria-label="Ver operación de transporte de maquinaria">
      <img src="/assets/imagenes_optimizadas/carga_maquinaria/img5.jpeg.jpg" alt="Transporte de maquinaria pesada sobre cama baja de TSA Logística" width="1280" height="961" loading="lazy" decoding="async">
      <div class="mcap">Carga Maquinaria</div>
    </div>
    <div class="mitem" onclick="openOpPanel('agricola',0)" role="button" tabindex="0" aria-label="Ver operación de equipo agrícola">
      <img src="/assets/imagenes_optimizadas/equipo_agricola/img2.jpeg.jpg" alt="Traslado de equipo agrícola en rampla plana por carretera" width="1600" height="719" loading="lazy" decoding="async">
      <div class="mcap">Equipo Agrícola</div>
    </div>
    <div class="mitem" onclick="openOpPanel('industrial',0)" role="button" tabindex="0" aria-label="Ver operación de carga industrial">
      <img src="/assets/imagenes_optimizadas/carga_industrial/img2.jpeg.jpg" alt="Transporte de carga industrial sobredimensionada de TSA Logística" width="1600" height="739" loading="lazy" decoding="async">
      <div class="mcap">Carga Industrial</div>
    </div>
    <div class="mitem" onclick="openOpPanel('cerrada',0)" role="button" tabindex="0" aria-label="Ver operación de carga cerrada">
      <img src="/assets/imagenes_optimizadas/carga_cerrada/img2.jpeg.jpg" alt="Camión síder de carga cerrada de la flota TSA Logística" width="1280" height="960" loading="lazy" decoding="async">
      <div class="mcap">Carga Cerrada</div>
    </div>
    <div class="mitem" onclick="openOpPanel('mineria',0)" role="button" tabindex="0" aria-label="Ver operación de minería">
      <img src="/assets/imagenes_optimizadas/mineria/img6.jpeg.jpg" alt="Transporte de equipos para la industria minera en Chile" width="1280" height="590" loading="lazy" decoding="async">
      <div class="mcap">Minería</div>
    </div>
  </div>
</section>
